# Copy this file to .env and fill in real values. Never commit .env itself.

# CollegeFootballData.com API key (bearer token). Get one at https://collegefootballdata.com/key
CFBD_API_KEY=PASTE_YOUR_API_KEY_HERE

# ---- API (Phase 6A). The API never needs CFBD_API_KEY: it serves from local, verified artifacts. ----
# Comma-separated explicit allowlist of frontend origins (no wildcard; credentials are never allowed)
FRONTEND_ORIGINS=http://localhost:3000
# Requests per minute per client address for /api/* (0 disables; enforce at the platform edge as well)
RATE_LIMIT_PER_MINUTE=120
# Serving bundle directory, relative to nfl-qb-analytics/ (built with: python -m api.bundle build)
QB_API_BUNDLE_DIR=data/serving/v1
# Simulation draws for year-by-year paths (fixed seed: identical inputs give identical outputs)
QB_API_N_SIMS=2000
# In-memory forecast cache entries (0 disables)
QB_API_CACHE_SIZE=512
QB_API_MAX_PAGE_SIZE=50
# Set to false to hide /docs and /openapi.json in production
QB_API_DOCS_ENABLED=true
LOG_LEVEL=INFO
APP_ENV=development

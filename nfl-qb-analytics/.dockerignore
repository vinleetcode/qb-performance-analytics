# Only the inference runtime enters the image (see Dockerfile). Everything else is excluded.
.env
.env.*
**/.claude
.git
.venv
venv
**/__pycache__
.pytest_cache
results/
reports/
tests/
# all local data: the serving bundle enters only as the verified archive (dist/ locally, or QB_BUNDLE_URL)
data/
dist/*
!dist/qb_serving_bundle_v1.tar.gz
models/qb_career_production/v1.0.0/
models/qb_career_success/v1.0.0/
# Render copies secret files into the build context root; they are read only through the BuildKit secret mount
qb_bundle_token

*.parquet
*.feather
models/**/*.csv

# Generated results (re-created by the pipelines)
results/
*.npz

# Model files that embed player-level training data (NFL career lines, per-QB residuals).
# Kept locally and unchanged for reproducibility; superseded for distribution by
# models/qb_career_production/v1.1.0 (parameters only). See reports/phase5_5_audit.md.
models/qb_career_production/v1.0.0/*.joblib


# Base URL of the FastAPI backend (public: sent to browsers). No secrets belong in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Link shown in the header and footer
NEXT_PUBLIC_GITHUB_URL=https://github.com/vinleetcode/qb-performance-analytics
# Public URL of the site (for absolute Open Graph links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
